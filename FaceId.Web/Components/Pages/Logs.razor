@page "/logs"
@using System.Net.Http.Json
@using System.Globalization
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Журнал распознаваний</PageTitle>

<h1>Журнал распознаваний</h1>

<p>История попыток идентификации пользователей по лицу.</p>

<div class="mb-3">
    <button class="btn btn-primary"
            @onclick="LoadLogs"
            disabled="@isLoading">
        @(isLoading ? "Загрузка..." : "Обновить журнал")
    </button>
</div>

@if (isLoading && logs is null)
{
    <p>Загружаем журнал...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (logs is not null)
{
    <div class="mb-3">
        <strong>Всего записей:</strong> @logs.Count
        <span class="ms-3">
            <strong>Успешно:</strong>
            @logs.Count(log => log.Status == "Confirmed")
        </span>
        <span class="ms-3">
            <strong>Не найдено:</strong>
            @logs.Count(log => log.Status == "NotFound")
        </span>
    </div>

    @if (logs.Count == 0)
    {
        <div class="alert alert-info">
            Журнал пока пуст. Выполни распознавание, чтобы появилась запись.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Дата и время (UTC)</th>
                        <th>Пользователь</th>
                        <th>Email</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in logs)
                    {
                        <tr>
                            <td>@log.Id</td>
                            <td>
                                @log.RecognizedAt.ToUniversalTime().ToString("dd.MM.yyyy HH:mm:ss")
                            </td>
                            <td>
                                @if (log.User is not null)
                                {
                                    @($"{log.User.FirstName} {log.User.LastName}")
                                }
                                else
                                {
                                    <span class="text-muted">Не установлен</span>
                                }
                            </td>
                            <td>
                                @(log.User?.Email ?? "—")
                            </td>
                            <td>
                                @if (log.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        Успешно
                                    </span>
                                }
                                else if (log.Status == "NotFound")
                                {
                                    <span class="badge bg-danger">
                                        Не найдено
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @log.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<AccessLogDto>? logs;
    private bool isLoading;
    private string? errorMessage;

    private async Task LoadLogs()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("FaceIdApi");

            logs = await client.GetFromJsonAsync<List<AccessLogDto>>(
                "api/AccessLogs");
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Не удалось получить журнал. Проверь, запущен ли API.";
        }
        catch (TaskCanceledException)
        {
            errorMessage =
                "Превышено время ожидания ответа от API.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage =
                "Не удалось обработать ответ API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    public class AccessLogDto
    {
        public int Id { get; set; }

        public int? UserId { get; set; }

        public DateTimeOffset RecognizedAt { get; set; }

        public string Status { get; set; } = string.Empty;

        public AccessLogUserDto? User { get; set; }
    }

    public class AccessLogUserDto
    {
        public int Id { get; set; }

        public string FirstName { get; set; } = string.Empty;

        public string LastName { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;
    }
}